# OpenCode (Console API) - LLM e descrizione immagini
# Chiave personale: https://opencode.ai/console -> Account -> Personal API keys
OPENCODE_API_KEY=oc_sk_...
OPENCODE_MODEL=deepseek-v4.1-flash
# Piano Go (abbonamento). Per pay-as-you-go: https://opencode.ai/inference/openai/v1
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
# Header richiesto dal piano Go: instrada la conversazione e riusa la prompt cache
OPENCODE_SESSION_ID=ses_wiki_assistant_golfsuite
OPENCODE_USER_AGENT=wiki-assistant/1.0
VISION_MODEL=deepseek-v4.1-flash

# Embeddings: modello locale, nessuna API esterna
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

# OpenRouter (opzionale): serve solo come fallback per le embeddings
# con EMBEDDING_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Confluence Wiki
WIKI_BASE_URL=https://nexxchange.atlassian.net/wiki
WIKI_SPACES=GOLIT,GOLFR,GSN2,NA,NW,POR,PORFR,PORNL
# WIKI_EMAIL: la tua email di accesso a nexxchange.atlassian.net
WIKI_EMAIL=tua.email@azienda.com
# WIKI_API_TOKEN: vai su https://id.atlassian.com/manage/api-tokens -> "Crea token API"
WIKI_API_TOKEN=il-tuo-token-atlassian

# PostgreSQL
# Docker Compose: lascia cosi, il container db si chiama "db"
# Locale: cambia in postgresql+psycopg://ai:ai@localhost:5432/ai
DATABASE_URL=postgresql+psycopg://ai:ai@db:5432/ai

# App
APP_ENV=production
HOST=0.0.0.0
PORT=7777
