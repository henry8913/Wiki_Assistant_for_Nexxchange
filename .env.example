# OpenRouter
# Vai su https://openrouter.ai/keys -> crea una chiave
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o

# Confluence Wiki
WIKI_BASE_URL=https://nexxchange.atlassian.net/wiki
WIKI_SPACES=GOLIT,GOLFR,GSN2,NA,NW,POR,PORFR,PORNL
# WIKI_EMAIL: la tua email di accesso a nexxchange.atlassian.net
WIKI_EMAIL=tua.email@azienda.com
# WIKI_API_TOKEN: vai su https://id.atlassian.com/manage/api-tokens -> "Crea token API"
WIKI_API_TOKEN=il-tuo-token-atlassian

# PostgreSQL
# Docker Compose: lascia cosi, il container db si chiama "db"
# Locale: cambia in postgresql+psycopg://ai:ai@localhost:5432/ai
DATABASE_URL=postgresql+psycopg://ai:ai@db:5432/ai

# Le embeddings usano OpenRouter (stessa chiave di sopra)
# Non serve una chiave OpenAI separata

# App
APP_ENV=production
HOST=0.0.0.0
PORT=7777
